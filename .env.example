# Optional — leave unset for deterministic demo mode (rules engine only)

# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.8-flash

# When both keys are set: openai | gemini | rules (rules forces demo even with keys)
# LLM_PROVIDER=openai
# AI_PROVIDER is an alias of LLM_PROVIDER

# PORT=5173

# Max parallel LLM requests in AI mode (default 4)
# LLM_CONCURRENCY=4
